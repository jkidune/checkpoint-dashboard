{
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "framework": null,
  "crons": [
    {
      "path": "/api/cron/member-reminders",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/automatic-fines",
      "schedule": "10 6 * * *"
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
